{
    "name": "israel-nogueira/sky-session",
    "description": "Uma classe moderna, segura e com testes para gerenciamento de sessões em PHP",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "session",
        "security",
        "encryption",
        "aes-256",
        "php8"
    ],
    "authors": [
        {
            "name": "Israel Nogueira",
            "email": "israel@feats.com.br"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "IsraelNogueira\\SkySession\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IsraelNogueira\\SkySession\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse src --level=max",
        "cs:check": "phpcs src tests --standard=PSR12",
        "cs:fix": "phpcbf src tests --standard=PSR12"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
