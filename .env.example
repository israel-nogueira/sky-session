# Session Configuration

# Nome da sessão
SESSION_NAME=sky_session

# Tempo de vida da sessão em segundos (3600 = 1 hora)
SESSION_LIFETIME=3600

# Ativar criptografia (true/false)
SESSION_SECURE=true

# Chave de criptografia (32 bytes hexadecimal)
# Gere usando: php -r "echo bin2hex(random_bytes(16));"
SESSION_CRYPT_KEY=

# Vetor de inicialização (16 bytes em base64)
# Gere usando: php -r "echo base64_encode(random_bytes(16));"
SESSION_CRYPT_IV=

# Cookie configuration
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

# Caminho de salvamento da sessão (opcional)
SESSION_SAVE_PATH=
